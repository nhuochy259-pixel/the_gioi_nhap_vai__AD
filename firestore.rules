rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().get('role', 'USER') == role;
    }
    
    function isAdmin() {
      return hasRole('ADMIN');
    }
    
    function isModerator() {
      return hasRole('MODERATOR') || isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if true; // Public profiles must be readable by guests and authenticated users
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if (isSignedIn() && isOwner(userId) && 
                      (!request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['role', 'permissions', 'isLocked', 'strikeCount', 'lockExpiresAt', 'lockReason']) ||
                       (resource.data.moderatorInviteStatus == 'PENDING' && request.resource.data.role == 'MODERATOR'))) ||
                    isModerator();
      allow delete: if isAdmin();
    }

    // Characters
    match /characters/{charId} {
      allow read: if true;
      allow create: if isSignedIn() && getUserData().get('creatorStatus', false) == true;
      allow update: if (isSignedIn() && resource.data.creatorId == request.auth.uid) || isModerator();
      allow delete: if (isSignedIn() && resource.data.creatorId == request.auth.uid) || isModerator();
    }

    // Prompts
    match /prompts/{promptId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isModerator();
      allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isModerator();
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isSignedIn();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isModerator() || (isSignedIn() && request.resource.data.action == 'ID_RESERVED');
      allow update, delete: if false; // Immutable
    }

    // Global IDs (Numeric IDs lookup)
    match /global_ids/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false; // Reserved IDs are immutable
    }

    // Creator Requests
    match /creator_requests/{requestId} {
      allow read: if isModerator() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // Contact Forms
    match /contact_forms/{formId} {
      allow read: if isModerator();
      allow create: if true; // Public can contact
      allow update: if isModerator();
      allow delete: if isAdmin();
    }
    
    // Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('recipientId', '') == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('recipientId', '') == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('recipientId', '') == request.auth.uid);
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isModerator();
      allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isModerator();
    }

    // Tags
    match /tags/{tagId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isModerator();
      allow delete: if isModerator();
    }

    // Bookmarks
    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Follows
    match /follows/{followId} {
      allow read: if true; // Follow metrics and creators public list can be read
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // Feedbacks
    match /feedbacks/{feedbackId} {
      allow read: if resource.data.get('mode', 'PUBLIC') == 'PUBLIC' || (isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if (isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid)) || isModerator();
      allow delete: if (isSignedIn() && resource.data.recipientId == request.auth.uid) || isModerator();
    }

    // Appeals
    match /appeals/{appealId} {
      allow read: if isModerator() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // Character Likes
    match /character_likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // General/Prompt Likes
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
